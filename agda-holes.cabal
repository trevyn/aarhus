cabal-version:      2.4
name:               agda-holes
version:            0.1.0.0
synopsis:           CLI tool to query Agda holes
license:            MIT
author:             Claude
maintainer:         example@example.com
category:           Development
build-type:         Simple

executable agda-holes
    main-is:          Main.hs
    build-depends:    base >= 4.14.0.0 && < 5,
                      optparse-applicative
    hs-source-dirs:   src
    default-language: Haskell2010
    ghc-options:      -Wall -threaded
